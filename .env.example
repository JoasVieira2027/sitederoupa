# ============================================================
# LOJA DE ROUPAS - VARIÁVEIS DE AMBIENTE (VERCEL / LOCAL)
# ============================================================
# Nunca envie chaves de produção para o repositório Git!
# Configure estas variáveis no painel da Vercel (Settings > Environment Variables)
# ou em um arquivo local .env (já ignorado pelo git).

# URL do seu projeto no Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública do Supabase (Anon Key)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de Serviço (Opcional - apenas para funções de backend)
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# INSTAGRAM GRAPH API (META OFICIAL)
# ============================================================
# Token de acesso de longa duração obtido via Meta for Developers (Graph API)
# Permissão necessária: instagram_basic / instagram_graph_user_media
# Este token NUNCA é exposto no frontend, ficando 100% seguro na Vercel.
INSTAGRAM_ACCESS_TOKEN=IGQWR...

# ID da conta do Instagram (Opcional - necessário caso use endpoint Business via Facebook Page)
# INSTAGRAM_USER_ID=178414...
